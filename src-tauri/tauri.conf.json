{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iim",
  "version": "0.1.0",
  "identifier": "com.iim.lan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "iim",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "spurh",
    "homepage": "https://spurh.com",
    "copyright": "Copyright (c) 2026 spurh. All rights reserved.",
    "shortDescription": "spurh LAN instant messenger",
    "longDescription": "A reliable peer-to-peer instant messenger for local networks, created by xuning for spurh.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
